# ── 服务 ──
FRONTEND_PORT=5173
BACKEND_PORT=8000

# ── 运行模式：1=实验室模式（启用模拟 IP 头与管理端点），0=生产语义 ──
LAB_MODE=1

# ── 存储 ──
DATABASE_URL=sqlite:///./anticrawl.db

# ── Redis（可选）：留空自动降级 fakeredis；填 redis://127.0.0.1:6379/0 用真实实例 ──
REDIS_URL=

# ── 风控参数 ──
RATE_LIMIT_QPS=10            # 单 IP 业务接口限流（滑动窗口，秒）
FP_RATE_LIMIT_QPS=30         # 单指纹维度限流阈值
BAN_SECONDS=600              # 蜜罐/黑名单封禁时长（秒）
SIGN_SECRET=change-me-in-lab
SIGN_WINDOW_SECONDS=120      # 签名时间窗 ±120s
NONCE_TTL_SECONDS=300        # nonce 去重窗口
POW_DIFFICULTY=4             # PoW 前导零个数
DATA_RETENTION_DAYS=7        # 日志滚动清理天数

# ── 分级令牌桶限流与匿名浏览配额（增强实验） ──
ANON_MAX_PAGE=2              # 匿名游客免费浏览最大页码（第 3 页起需登录或 PoW）
ANON_MAX_VIEWS=15            # 匿名累计翻页/深度浏览配额
PUBLIC_BUCKET_BURST=60       # 普通域令牌桶突发容量
PUBLIC_BUCKET_RATE=30        # 普通域每秒补充令牌数
SENSITIVE_BUCKET_BURST=8     # 高敏域（底价/PoW/WAF）突发容量
SENSITIVE_BUCKET_RATE=4      # 高敏域每秒补充令牌数
